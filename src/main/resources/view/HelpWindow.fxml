<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import seedu.address.ui.HelpContentView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <!-- The main window's theme supplies the shared colours; HelpWindow.css lays out the help content. -->
        <URL value="@DarkTheme.css" />
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox fx:id="helpContainer" spacing="10">
        <children>
          <Label fx:id="helpHeading" text="Available commands" />
          <Label fx:id="helpCloseHint" text="Press q while this window is active to close it." wrapText="true" />
          <ScrollPane fx:id="helpScroll" fitToWidth="true" focusTraversable="true"
                      hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <content>
              <HelpContentView fx:id="helpContent" />
            </content>
          </ScrollPane>
        </children>
        <padding>
          <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
      </VBox>
    </Scene>
  </scene>
</fx:root>
