<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>

<!-- Column min/pref widths, spacing and padding must match the header row in PersonListPanel.fxml. -->
<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="10" styleClass="person-row"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="8" bottom="8" left="8" />
  </padding>
  <Label fx:id="id" styleClass="cell-id" minWidth="32" prefWidth="32" alignment="CENTER_RIGHT" />
  <Label fx:id="name" styleClass="cell-name" minWidth="80" prefWidth="170" />
  <Label fx:id="phone" styleClass="cell" minWidth="64" prefWidth="84" />
  <Label fx:id="department" styleClass="cell" minWidth="50" prefWidth="110" />
  <FlowPane fx:id="tags" HBox.hgrow="ALWAYS" minWidth="40" prefWidth="110" prefWrapLength="110" />
</HBox>
