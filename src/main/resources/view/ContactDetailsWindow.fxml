<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<Stage xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
       title="Contact details" minWidth="320" minHeight="220">
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@Extensions.css" />
      </stylesheets>
      <VBox spacing="4" prefWidth="560" prefHeight="420" styleClass="details-window">
        <padding>
          <Insets top="4" right="8" bottom="8" left="4" />
        </padding>
        <Label text="[3] Details" styleClass="pane-title" />
        <StackPane fx:id="detailsPanelPlaceholder" VBox.vgrow="ALWAYS" />
        <Label text="j/k move · Ctrl+C copy · q close · Esc prompt · Alt+3 next popup" styleClass="key-hint"
               wrapText="true">
          <padding>
            <Insets left="8" />
          </padding>
        </Label>
      </VBox>
    </Scene>
  </scene>
</Stage>
